# Variáveis de Ambiente — Reybraztech
# Copie para .env e preencha os valores reais.
# NUNCA commite o .env com credenciais.

# ============================================================
# BACKEND (Vercel) — Servidor principal
# ============================================================

# --- OBRIGATÓRIAS (app não inicia sem) ---
JWT_SECRET=
DATABASE_URL=

# --- Opcionais mas recomendadas ---
PORT=3001
SENTRY_DSN=
FRONTEND_URL=

# --- Telegram (notificações do backend) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp SendPulse (obrigatório se usar WhatsApp) ---
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
SENDPULSE_BOT_ID=

# --- Mercado Pago (pagamentos) ---
MERCADO_PAGO_ACCESS_TOKEN=
PAYMENT_WEBHOOK_URL=
MERCADO_PAGO_LINK_MENSAL=
MERCADO_PAGO_LINK_TRIMESTRAL=
MERCADO_PAGO_LINK_SEMESTRAL=
MERCADO_PAGO_LINK_ANUAL=

# --- Supabase (opcional, DATABASE_URL já cobre o essencial) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- Scraper (backend precisa saber onde está o scraper) ---
SCRAPER_URL=https://reybraztech-scraper.onrender.com
SCRAPER_API_KEY=

# ============================================================
# SCRAPER (Render) — Serviço Puppeteer (porta 3000)
# ============================================================

# --- OBRIGATÓRIAS ---
DATABASE_URL=                    # MESMA do backend (Supabase)
SCRAPER_API_KEY=                 # MESMA do backend

# --- Login no painel StarHome ---
PANEL_URL=https://panel.web.starhome.vip
PANEL_ACCOUNT=
PANEL_PASSWORD=

# Admin Starhome (opcional — usar hash bcrypt em vez de senha direta)
# Para gerar o hash, execute no Node.js:
# const bcrypt = require('bcryptjs');
# const hash = await bcrypt.hash('sua_senha', 10);
# console.log(hash);
STARHOME_PASSWORD_HASH=

# --- Comportamento ---
HEADLESS=true
ITEMS_PER_PAGE=100
PAGE_LIMIT=0

# --- Telegram (notificações do scraper) ---
TELEGRAM_BOT_TOKEN=              # MESMO do backend
TELEGRAM_CHAT_ID=                # MESMO do backend

# --- 2Captcha (opcional, resolve captcha automático) ---
TWO_CAPTCHA_API_KEY=

# --- Render (não mexer) ---
NODE_ENV=production
PUPPETEER_CACHE_DIR=/opt/render/.cache/puppeteer

# ============================================================
# FRONTEND (Vercel) — React app
# ============================================================

# --- Opcionais (todas têm fallback) ---
VITE_API_URL=                    # Em produção deixa vazio. Local: http://localhost:3001
VITE_SENTRY_DSN=
VITE_SCRAPER_URL=https://reybraztech-scraper.onrender.com
VITE_SCRAPER_API_KEY=            # MESMA SCRAPER_API_KEY do backend/scraper
